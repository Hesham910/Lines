# Use the platform-managed Postgres URL in the sandbox.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_SITE_URL=https://lines.ch
# Enable on the live domain if it should not be embedded. Leave off in preview.
LINES_FRAME_PROTECTION=0

# Transactional mail — server only. Sender must belong to your verified Resend domain.
RESEND_API_KEY=
LINES_EMAIL_FROM=

# Basic Consent Mode; analytics is off until consent is granted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Real HTTPS path of the external Lines-trips registration screen.
NEXT_PUBLIC_LINES_TRIPS_REGISTER_URL=

# App launch activates only when all four store URLs and the timestamp are valid.
# Set an ISO 8601 value with offset (e.g. YYYY-MM-DDTHH:MM:SS+02:00).
NEXT_PUBLIC_LINES_LAUNCH_AT=
NEXT_PUBLIC_RIDER_GOOGLE_PLAY_URL=
NEXT_PUBLIC_RIDER_APP_STORE_URL=
NEXT_PUBLIC_DRIVER_GOOGLE_PLAY_URL=
NEXT_PUBLIC_DRIVER_APP_STORE_URL=

# Only mark legal as approved after all three editions have Swiss legal sign-off.
LINES_LEGAL_APPROVED=0
LINES_LEGAL_NAME=
LINES_CHE_ID=
LINES_REGISTERED_ADDRESS=
